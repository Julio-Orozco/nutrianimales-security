-- Identidades generadas y FK previenen referencias imposibles en los datos ficticios.

-- Archivo: nutrianimales-seguridad/db/sql/02-schema.sql
CREATE EXTENSION pg_stat_statements;
CREATE TABLE plantas (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre text NOT NULL, ubicacion text NOT NULL,
  capacidad_produccion numeric NOT NULL CHECK (capacidad_produccion > 0), estado text NOT NULL
);
CREATE TABLE productos (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  codigo text NOT NULL UNIQUE, nombre text NOT NULL, tipo text NOT NULL,
  precio_unitario numeric(12,2) NOT NULL CHECK (precio_unitario >= 0), activo boolean NOT NULL DEFAULT true
);
CREATE TABLE materias_primas (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre text NOT NULL, categoria text NOT NULL, stock_actual numeric NOT NULL,
  stock_minimo numeric NOT NULL, proveedor text NOT NULL
);
CREATE TABLE lotes_produccion (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  codigo text NOT NULL UNIQUE, planta_id integer NOT NULL REFERENCES plantas,
  producto_id integer NOT NULL REFERENCES productos,
  cantidad_producida numeric NOT NULL CHECK (cantidad_producida > 0),
  fecha_inicio timestamptz NOT NULL DEFAULT now(), estado text NOT NULL
);
CREATE TABLE clientes (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre text NOT NULL, tipo text NOT NULL, correo text NOT NULL, segmento text NOT NULL
);
-- Se permite correo duplicado exclusivamente para demostrar D4 con datos ficticios.
CREATE INDEX idx_clientes_correo ON clientes(correo);
CREATE TABLE ventas (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  cliente_id integer NOT NULL REFERENCES clientes, producto_id integer NOT NULL REFERENCES productos,
  cantidad numeric NOT NULL CHECK (cantidad > 0), precio_total numeric(14,2) NOT NULL,
  fecha timestamptz NOT NULL DEFAULT now(), estado text NOT NULL
);
CREATE TABLE control_calidad (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  lote_id integer NOT NULL REFERENCES lotes_produccion ON DELETE CASCADE,
  parametro text NOT NULL, valor_obtenido numeric NOT NULL, valor_esperado numeric NOT NULL,
  aprobado boolean NOT NULL
);
CREATE TABLE gastos (
  id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  categoria text NOT NULL, descripcion text NOT NULL, monto numeric(14,2) NOT NULL,
  fecha timestamptz NOT NULL DEFAULT now(), aprobado_por text NOT NULL
);
CREATE TABLE auditoria_datos (
  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  tabla text NOT NULL, operacion text NOT NULL, usuario text NOT NULL,
  fecha timestamptz NOT NULL DEFAULT clock_timestamp(), ip_cliente inet,
  fila_id integer, valor_antes jsonb, valor_nuevo jsonb, transaccion bigint
);
CREATE INDEX idx_audit_tabla ON auditoria_datos(tabla);
CREATE INDEX idx_audit_usuario ON auditoria_datos(usuario);
CREATE INDEX idx_audit_fecha ON auditoria_datos(fecha);
-- Complemento: filas por sentencia, no suma histórica de pg_stat_statements.
CREATE TABLE auditoria_sentencias (
  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY, tabla text NOT NULL,
  operacion text NOT NULL, usuario text NOT NULL, filas bigint NOT NULL,
  consulta text NOT NULL, fecha timestamptz NOT NULL DEFAULT clock_timestamp()
);
CREATE TABLE eventos_seguridad (
  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  fuente text NOT NULL, tipo text NOT NULL, detalle jsonb NOT NULL,
  fecha timestamptz NOT NULL DEFAULT clock_timestamp(), huella text NOT NULL UNIQUE
);
CREATE TABLE backups (
  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  fecha timestamptz NOT NULL DEFAULT now(), estado text NOT NULL,
  ruta text NOT NULL, sha256 text, tamano bigint
);
CREATE TABLE alertas_auditoria (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tipo text NOT NULL,
  alerta text NOT NULL, mensaje text NOT NULL, detalles jsonb NOT NULL,
  fecha timestamptz NOT NULL DEFAULT clock_timestamp(), severidad text NOT NULL,
  huella text NOT NULL UNIQUE, estado text NOT NULL DEFAULT 'pendiente',
  intentos integer NOT NULL DEFAULT 0, enviada_en timestamptz, ultimo_error text
);
CREATE TABLE pg_settings_baseline (name text PRIMARY KEY, valor_esperado text NOT NULL);
INSERT INTO pg_settings_baseline
SELECT name, setting FROM pg_settings WHERE name IN
 ('ssl','password_encryption','work_mem','max_connections','shared_preload_libraries','log_min_duration_statement','log_connections');
-- Vistas agregadas: el gerente no necesita correos de clientes ni auditoría.
CREATE VIEW reporte_ventas AS
 SELECT p.tipo, count(*) AS operaciones, coalesce(sum(v.precio_total),0) AS total
 FROM ventas v JOIN productos p ON p.id=v.producto_id GROUP BY p.tipo;
CREATE VIEW reporte_inventario AS
 SELECT categoria, sum(stock_actual) AS existencias, sum(stock_minimo) AS minimo
 FROM materias_primas GROUP BY categoria;
CREATE VIEW reporte_produccion AS
 SELECT p.nombre AS planta, count(*) AS lotes, sum(l.cantidad_producida) AS cantidad
 FROM lotes_produccion l JOIN plantas p ON p.id=l.planta_id GROUP BY p.nombre;
