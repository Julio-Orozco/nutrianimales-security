      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "D4",
              "leftValue": "={{ $json.detected }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "position": [
        520,
        0
      ],
      "notes": "Solo la rama verdadera solicita notificación. Sin hallazgo no se envía Telegram.",
      "notesInFlow": true
    },
    {
      "id": "870146a7-cb4a-5668-81bd-b27dece030a3",
