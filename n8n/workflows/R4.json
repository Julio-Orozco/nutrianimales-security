{
  "id": "nutriR4alerta00",
  "name": "Nutri R4 — Intentos de autenticación fallidos",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "cada-30-segundos",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Sondeo periódico de la regla R4.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "prueba-manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "notes": "Ejecutar la regla a mano desde el editor.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ev AS (\n  SELECT 'PostgreSQL' AS fuente, fecha, usuario, ip\n  FROM eventos_log_pg(interval '10 minutes') WHERE tipo = 'auth_fallida'\n  UNION ALL\n  SELECT 'SSH', fecha, detalle->>'usuario', detalle->>'ip'\n  FROM eventos_seguridad\n  WHERE fuente = 'ssh' AND tipo = 'auth_fallida' AND fecha > now() - interval '10 minutes'\n)\nSELECT 'R4-' || fuente || '-' || to_char(date_bin('10 minutes', now(), timestamptz '2000-01-01'), 'YYYYMMDDHH24MI') AS huella,\n       fuente, count(*) AS intentos, string_agg(DISTINCT usuario, ', ') AS usuarios, string_agg(DISTINCT ip, ', ') AS ips,\n       format(E'Fuente: %s\\nIntentos fallidos en 10 min: %s (umbral: 5)\\nUsuarios probados: %s\\nIP de origen: %s\\nÚltimo intento: %s',\n              fuente, count(*), string_agg(DISTINCT usuario, ', '), string_agg(DISTINCT ip, ', '),\n              to_char(max(fecha) AT TIME ZONE 'America/Costa_Rica', 'YYYY-MM-DD HH24:MI:SS')) AS texto\nFROM ev\nGROUP BY fuente\nHAVING count(*) > 5;",
        "options": {}
      },
      "id": "detectar",
      "name": "Detectar R4",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Fuente: Log JSON de PostgreSQL (eventos_log_pg) + auth.log SSH (agente del host)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.huella }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-hay-hallazgo-",
      "name": "¿Hay hallazgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alertas_auditoria (tipo, alerta, mensaje, detalles, severidad, huella)\nVALUES ('rendimiento', 'R4', 'Intentos de autenticación fallidos', $1::jsonb, 'critica', $2)\nON CONFLICT (huella) DO UPDATE SET intentos = alertas_auditoria.intentos\n  WHERE alertas_auditoria.estado = 'pendiente'\nRETURNING id::text AS id;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json), $json.huella ] }}"
        }
      },
      "id": "registrar",
      "name": "Registrar alerta R4",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "La huella UNIQUE evita repetir un hallazgo ya enviado; si quedó pendiente (falló Telegram) se reintenta.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-alerta-nueva-",
      "name": "¿Alerta nueva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "=<b>ALERTA CRÍTICA - NutriAnimales S.A. | Lead University BCD 9220</b>\n<b>Alerta:</b> R4 — Intentos de autenticación fallidos\n<b>Fecha:</b> {{ $now.setZone('America/Costa_Rica').toFormat('yyyy-MM-dd HH:mm:ss') }}\n{{ $('Detectar R4').item.json.texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}\n<b>Severidad:</b> CRÍTICA\n<b>Acción:</b> Bloquear la IP de origen (sudo ufw deny from &lt;ip&gt;) y revisar/rotar la cuenta atacada.\n<i>Registro: alertas_auditoria {{ $('Registrar alerta R4').item.json.id }}</i>",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "enviar-telegram",
      "name": "Enviar alerta R4",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        100
      ],
      "webhookId": "nutri-R4-telegram",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_TELEGRAM__",
          "name": "Nutri Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alertas_auditoria\nSET estado = 'enviada', enviada_en = now(), intentos = intentos + 1\nWHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Registrar alerta R4').item.json.id ] }}"
        }
      },
      "id": "marcar-enviada",
      "name": "Marcar enviada R4",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Deja constancia de la entrega en alertas_auditoria.",
      "notesInFlow": true
    }
  ],
