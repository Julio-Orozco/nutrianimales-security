    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH priv AS (\n  SELECT security_snapshot() -> 'privilegios_agente' AS p\n)\nSELECT\n  p AS privilegios,\n  (p->>'superuser')::boolean AS superuser,\n  (p->>'createrole')::boolean AS createrole,\n  (p->>'createdb')::boolean AS createdb,\n  (p->>'create_schema')::boolean AS create_schema,\n  p->'escritura' AS escritura\nFROM priv\nWHERE (p->>'superuser')::boolean\n   OR (p->>'createrole')::boolean\n   OR (p->>'createdb')::boolean\n   OR (p->>'create_schema')::boolean\n   OR jsonb_array_length(p->'escritura') > 0;",
        "options": {}
