    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH baseline(archivo, hash_esperado) AS (\n  VALUES\n    ('pg_hba.conf', '692bc916ebf65ccc8cded34937e52ba402632e78df8bba3e7d29a0102bf112e2'),\n    ('postgresql.conf', 'dde326d96dc922583a8584524422bcc4cdde3d338c929e3af56ca21ecbb585c2'),\n    ('postgresql.auto.conf', '0874e665ecf5c0a6135a73158ea1b71a959dafb809574810da5c9cc28c0c63ed')\n),\nactuales AS (\n  SELECT key AS archivo, value AS hash_actual\n  FROM jsonb_each_text(security_snapshot() -> 'hashes')\n)\nSELECT\n  a.archivo,\n  b.hash_esperado,\n  a.hash_actual\nFROM actuales a\nJOIN baseline b USING (archivo)\nWHERE a.hash_actual IS DISTINCT FROM b.hash_esperado;",
        "options": {}
      },
