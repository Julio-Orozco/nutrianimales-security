{
  "id": "nutriH2alerta00",
  "name": "Nutri H2 — pg_hba.conf o postgresql.conf modificado",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "cada-30-segundos",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Sondeo periódico de la regla H2.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "prueba-manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "notes": "Ejecutar la regla a mano desde el editor.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH snap AS (SELECT security_snapshot() AS s)\nSELECT 'H2-' || h.key || '-' || h.value || '-' || extract(epoch FROM (snap.s->'modificado'->>h.key)::timestamptz)::bigint AS huella,\n       h.key AS archivo, b.hash_esperado, h.value AS hash_actual,\n       format(E'Archivo: %s\\nHash esperado: %s...\\nHash actual: %s...\\nÚltima modificación: %s',\n              h.key, left(b.hash_esperado, 16), left(h.value, 16),\n              to_char((snap.s->'modificado'->>h.key)::timestamptz, 'YYYY-MM-DD HH24:MI:SS')) AS texto\nFROM snap\nCROSS JOIN LATERAL jsonb_each_text(snap.s->'hashes') AS h\nJOIN archivos_baseline b ON b.archivo = h.key\nWHERE h.value <> b.hash_esperado;",
        "options": {}
      },
      "id": "detectar",
      "name": "Detectar H2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Fuente: security_snapshot() (SHA-256 del archivo) vs archivos_baseline",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.huella }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-hay-hallazgo-",
      "name": "¿Hay hallazgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alertas_auditoria (tipo, alerta, mensaje, detalles, severidad, huella)\nVALUES ('hardening', 'H2', 'pg_hba.conf o postgresql.conf modificado', $1::jsonb, 'critica', $2)\nON CONFLICT (huella) DO UPDATE SET intentos = alertas_auditoria.intentos\n  WHERE alertas_auditoria.estado = 'pendiente'\nRETURNING id::text AS id;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json), $json.huella ] }}"
        }
      },
      "id": "registrar",
      "name": "Registrar alerta H2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "La huella UNIQUE evita repetir un hallazgo ya enviado; si quedó pendiente (falló Telegram) se reintenta.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-alerta-nueva-",
      "name": "¿Alerta nueva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "=<b>ALERTA CRÍTICA - NutriAnimales S.A. | Lead University BCD 9220</b>\n<b>Alerta:</b> H2 — pg_hba.conf o postgresql.conf modificado\n<b>Fecha:</b> {{ $now.setZone('America/Costa_Rica').toFormat('yyyy-MM-dd HH:mm:ss') }}\n{{ $('Detectar H2').item.json.texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}\n<b>Severidad:</b> CRÍTICA\n<b>Acción:</b> Comparar con la versión del repositorio y restaurar; si el cambio es legítimo, registrar nueva baseline.\n<i>Registro: alertas_auditoria {{ $('Registrar alerta H2').item.json.id }}</i>",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "enviar-telegram",
      "name": "Enviar alerta H2",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        100
      ],
      "webhookId": "nutri-H2-telegram",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_TELEGRAM__",
          "name": "Nutri Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alertas_auditoria\nSET estado = 'enviada', enviada_en = now(), intentos = intentos + 1\nWHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Registrar alerta H2').item.json.id ] }}"
        }
      },
      "id": "marcar-enviada",
      "name": "Marcar enviada H2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Deja constancia de la entrega en alertas_auditoria.",
      "notesInFlow": true
    }
  ],
