    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  pid,\n  usename,\n  application_name,\n  client_addr::text AS ip,\n  backend_start,\n  EXTRACT(HOUR FROM backend_start AT TIME ZONE 'America/Costa_Rica')::int AS hora_cr\nFROM pg_stat_activity\nWHERE backend_type = 'client backend'\n  AND usename NOT IN ('monitor_db', 'postgres')\n  AND (\n    EXTRACT(HOUR FROM backend_start AT TIME ZONE 'America/Costa_Rica') >= 23\n    OR EXTRACT(HOUR FROM backend_start AT TIME ZONE 'America/Costa_Rica') < 6\n  );",
