{
  "id": "nutriR5alerta00",
  "name": "Nutri R5 — Cambio en parámetros de postgresql.conf",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "cada-30-segundos",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Sondeo periódico de la regla R5.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "prueba-manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "notes": "Ejecutar la regla a mano desde el editor.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'R5-' || s.name || '-' || s.setting || '-' || extract(epoch FROM pg_conf_load_time())::bigint AS huella,\n       s.name AS parametro, b.valor_esperado, s.setting AS valor_actual, s.source AS origen,\n       format(E'Parámetro: %s\\nValor baseline: %s\\nValor actual: %s\\nOrigen del cambio: %s\\nÚltima recarga de configuración: %s',\n              s.name, b.valor_esperado, s.setting, s.source, to_char(pg_conf_load_time(), 'YYYY-MM-DD HH24:MI:SS')) AS texto\nFROM pg_settings s\nJOIN pg_settings_baseline b ON b.name = s.name\nWHERE s.setting IS DISTINCT FROM b.valor_esperado;",
        "options": {}
      },
      "id": "detectar",
      "name": "Detectar R5",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Fuente: pg_settings vs pg_settings_baseline",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.huella }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-hay-hallazgo-",
      "name": "¿Hay hallazgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alertas_auditoria (tipo, alerta, mensaje, detalles, severidad, huella)\nVALUES ('rendimiento', 'R5', 'Cambio en parámetros de postgresql.conf', $1::jsonb, 'critica', $2)\nON CONFLICT (huella) DO UPDATE SET intentos = alertas_auditoria.intentos\n  WHERE alertas_auditoria.estado = 'pendiente'\nRETURNING id::text AS id;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json), $json.huella ] }}"
        }
      },
      "id": "registrar",
      "name": "Registrar alerta R5",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "La huella UNIQUE evita repetir un hallazgo ya enviado; si quedó pendiente (falló Telegram) se reintenta.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-alerta-nueva-",
      "name": "¿Alerta nueva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "=<b>ALERTA CRÍTICA - NutriAnimales S.A. | Lead University BCD 9220</b>\n<b>Alerta:</b> R5 — Cambio en parámetros de postgresql.conf\n<b>Fecha:</b> {{ $now.setZone('America/Costa_Rica').toFormat('yyyy-MM-dd HH:mm:ss') }}\n{{ $('Detectar R5').item.json.texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}\n<b>Severidad:</b> CRÍTICA\n<b>Acción:</b> Verificar si el cambio fue autorizado; revertir con ALTER SYSTEM RESET &lt;parámetro&gt;; SELECT pg_reload_conf();\n<i>Registro: alertas_auditoria {{ $('Registrar alerta R5').item.json.id }}</i>",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "enviar-telegram",
      "name": "Enviar alerta R5",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        100
      ],
      "webhookId": "nutri-R5-telegram",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_TELEGRAM__",
          "name": "Nutri Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alertas_auditoria\nSET estado = 'enviada', enviada_en = now(), intentos = intentos + 1\nWHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Registrar alerta R5').item.json.id ] }}"
        }
      },
      "id": "marcar-enviada",
      "name": "Marcar enviada R5",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Deja constancia de la entrega en alertas_auditoria.",
      "notesInFlow": true
    }
  ],
