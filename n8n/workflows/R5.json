    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  s.name AS parametro,\n  b.valor_esperado AS valor_baseline,\n  s.setting AS valor_actual,\n  s.source\nFROM pg_settings s\nJOIN pg_settings_baseline b ON b.name = s.name\nWHERE s.setting IS DISTINCT FROM b.valor_esperado;",
        "options": {}
      },
