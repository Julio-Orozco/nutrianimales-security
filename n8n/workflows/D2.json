{
  "id": "nutriD2alerta00",
  "name": "Nutri D2 — Crecimiento anormal de tabla",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "cada-30-segundos",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Sondeo periódico de la regla D2.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "prueba-manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "notes": "Ejecutar la regla a mano desde el editor.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH n AS (\n  SELECT tabla, count(*) AS nuevas, string_agg(DISTINCT usuario, ', ') AS usuarios\n  FROM auditoria_datos\n  WHERE operacion = 'INSERT' AND fecha > now() - interval '30 minutes'\n    AND tabla IN ('ventas', 'clientes', 'lotes_produccion', 'productos')\n  GROUP BY tabla\n), t AS (SELECT relname AS tabla, n_live_tup AS total FROM pg_stat_user_tables)\nSELECT 'D2-' || n.tabla || '-' || to_char(date_bin('30 minutes', now(), timestamptz '2000-01-01'), 'YYYYMMDDHH24MI') AS huella,\n       n.tabla, n.nuevas, t.total,\n       format(E'Tabla: %s\\nFilas nuevas en 30 min: %s (+%s%%, umbral: 20%%)\\nTotal actual: %s\\nUsuarios: %s',\n              n.tabla, n.nuevas, round(100.0 * n.nuevas / greatest(t.total - n.nuevas, 1), 1), t.total, n.usuarios) AS texto\nFROM n JOIN t USING (tabla)\nWHERE n.nuevas > 0.2 * greatest(t.total - n.nuevas, 1);",
        "options": {}
      },
      "id": "detectar",
      "name": "Detectar D2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Fuente: auditoria_datos (INSERT en 30 min) + pg_stat_user_tables",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.huella }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-hay-hallazgo-",
      "name": "¿Hay hallazgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alertas_auditoria (tipo, alerta, mensaje, detalles, severidad, huella)\nVALUES ('datos', 'D2', 'Crecimiento anormal de tabla', $1::jsonb, 'advertencia', $2)\nON CONFLICT (huella) DO UPDATE SET intentos = alertas_auditoria.intentos\n  WHERE alertas_auditoria.estado = 'pendiente'\nRETURNING id::text AS id;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json), $json.huella ] }}"
        }
      },
      "id": "registrar",
      "name": "Registrar alerta D2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "La huella UNIQUE evita repetir un hallazgo ya enviado; si quedó pendiente (falló Telegram) se reintenta.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-alerta-nueva-",
      "name": "¿Alerta nueva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "=<b>ALERTA ADVERTENCIA - NutriAnimales S.A. | Lead University BCD 9220</b>\n<b>Alerta:</b> D2 — Crecimiento anormal de tabla\n<b>Fecha:</b> {{ $now.setZone('America/Costa_Rica').toFormat('yyyy-MM-dd HH:mm:ss') }}\n{{ $('Detectar D2').item.json.texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}\n<b>Severidad:</b> ADVERTENCIA\n<b>Acción:</b> Verificar si es una carga legítima; revisar auditoria_datos por usuario e IP.\n<i>Registro: alertas_auditoria {{ $('Registrar alerta D2').item.json.id }}</i>",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "enviar-telegram",
      "name": "Enviar alerta D2",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        100
      ],
      "webhookId": "nutri-D2-telegram",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_TELEGRAM__",
          "name": "Nutri Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alertas_auditoria\nSET estado = 'enviada', enviada_en = now(), intentos = intentos + 1\nWHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Registrar alerta D2').item.json.id ] }}"
        }
      },
      "id": "marcar-enviada",
      "name": "Marcar enviada D2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Deja constancia de la entrega en alertas_auditoria.",
      "notesInFlow": true
    }
  ],
