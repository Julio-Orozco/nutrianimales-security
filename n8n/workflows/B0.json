[{"updatedAt":"2026-11-16T18:08:12.289Z","createdAt":"2026-11-16T17:40:17.129Z","id":"nutrianimalesB00","name":"Nutri B0 — Bot Telegram por polling","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"seconds","secondsInterval":15}]}},"id":"b0-01-schedule","name":"Cada 15 segundos","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[0,0]},{"parameters":{"jsCode":"const data = $getWorkflowStaticData('global');\nconst offset = data.lastUpdateId ? data.lastUpdateId + 1 : 0;\nreturn [{ json: { offset } }];"},"id":"b0-02-offset","name":"Preparar offset","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0]},{"parameters":{"url":"https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates","sendQuery":true,"queryParameters":{"parameters":[{"name":"offset","value":"={{ $json.offset }}"},{"name":"timeout","value":"0"}]},"options":{}},"id":"b0-03-getupdates","name":"Leer mensajes Telegram","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[448,0]},{"parameters":{"jsCode":"const data = $getWorkflowStaticData('global');\nconst updates = $json.result || [];\nconst allowedChats = [-5513672600, 1275771153];\nconst salida = [];\n\nfor (const u of updates) {\n  if (!data.lastUpdateId || u.update_id > data.lastUpdateId) {\n    data.lastUpdateId = u.update_id;\n  }\n  const msg = u.message || u.edited_message;\n  if (!msg || !msg.text || !msg.chat) continue;\n  const chatId = msg.chat.id;\n  if (!allowedChats.includes(chatId)) continue;\n\n  const texto = msg.text.trim().toLowerCase();\n  let reporte = 'ayuda';\n  if (texto.startsWith('/ventas') || texto.includes('ventas')) reporte = 'ventas';\n  else if (texto.startsWith('/inventario') || texto.includes('inventario')) reporte = 'inventario';\n  else if (texto.startsWith('/produccion') || texto.includes('produccion') || texto.includes('producción')) reporte = 'produccion';\n\n  salida.push({\n    json: {\n      update_id: u.update_id,\n      chat_id: chatId,\n      usuario: msg.from?.first_name || 'Usuario',\n      comando: texto,\n      reporte\n    }\n  });\n}\n\nreturn salida;"},"id":"b0-04-validar","name":"Validar chat y comando","type":"n8n-nodes-base.code","typeVersion":2,"position":[688,0]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"leftValue":"={{ $json.reporte }}","rightValue":"ventas","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"ventas"},{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"leftValue":"={{ $json.reporte }}","rightValue":"inventario","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"inventario"},{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"leftValue":"={{ $json.reporte }}","rightValue":"produccion","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"produccion"}]},"options":{"fallbackOutput":"extra"}},"id":"b0-05-switch","name":"Enrutar consulta","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[928,0]},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM reporte_ventas;","options":{}},"id":"b0-06-ventas","name":"SQL Ventas (solo lectura)","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1200,-224],"credentials":{"postgres":{"id":"KGBDUlLWU9n2TTvZ","name":"Nutri Postgres agente_ia"}}},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM reporte_inventario;","options":{}},"id":"b0-07-inventario","name":"SQL Inventario (solo lectura)","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1200,-48],"credentials":{"postgres":{"id":"KGBDUlLWU9n2TTvZ","name":"Nutri Postgres agente_ia"}}},{"parameters":{"operation":"e