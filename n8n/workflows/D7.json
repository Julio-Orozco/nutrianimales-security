{
  "id": "nutriD7alerta00",
  "name": "Nutri D7 — Exfiltración, SELECT masivo en tabla sensible",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "cada-30-segundos",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Sondeo periódico de la regla D7.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "prueba-manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "notes": "Ejecutar la regla a mano desde el editor.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'D7-' || s.queryid || '-' || s.calls || '-' || (SELECT extract(epoch FROM stats_reset)::bigint FROM pg_stat_statements_info) AS huella,\n       r.rolname AS usuario, s.calls, s.rows, s.rows / s.calls AS filas_por_ejecucion,\n       format(E'Tabla: %s\\nFilas retornadas: %s por ejecución (umbral: 1000) | acumuladas: %s en %s ejecuciones\\nQuery: %s\\nUsuario: %s',\n              substring(s.query from '(?i)\\m(clientes|ventas)\\M'), s.rows / s.calls, s.rows, s.calls,\n              left(regexp_replace(s.query, '\\s+', ' ', 'g'), 200), r.rolname) AS texto\nFROM pg_stat_statements s\nJOIN pg_roles r ON r.oid = s.userid\nWHERE s.query ~* '^\\s*SELECT'\n  AND s.query ~* '\\m(clientes|ventas)\\M'\n  AND s.rows / s.calls > 1000\n  AND r.rolname NOT IN ('backup_db', 'monitor_db', 'n8n_app')\n  AND s.query NOT ILIKE '%pg_stat_statements%'\nORDER BY s.rows DESC\nLIMIT 5;",
        "options": {}
      },
      "id": "detectar",
      "name": "Detectar D7",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Fuente: pg_stat_statements (filas por ejecución > 1000 en clientes/ventas)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.huella }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-hay-hallazgo-",
      "name": "¿Hay hallazgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alertas_auditoria (tipo, alerta, mensaje, detalles, severidad, huella)\nVALUES ('datos', 'D7', 'Exfiltración, SELECT masivo en tabla sensible', $1::jsonb, 'critica', $2)\nON CONFLICT (huella) DO UPDATE SET intentos = alertas_auditoria.intentos\n  WHERE alertas_auditoria.estado = 'pendiente'\nRETURNING id::text AS id;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json), $json.huella ] }}"
        }
      },
      "id": "registrar",
      "name": "Registrar alerta D7",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "La huella UNIQUE evita repetir un hallazgo ya enviado; si quedó pendiente (falló Telegram) se reintenta.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-alerta-nueva-",
      "name": "¿Alerta nueva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "=<b>ALERTA CRÍTICA - NutriAnimales S.A. | Lead University BCD 9220</b>\n<b>Alerta:</b> D7 — Exfiltración, SELECT masivo en tabla sensible\n<b>Fecha:</b> {{ $now.setZone('America/Costa_Rica').toFormat('yyyy-MM-dd HH:mm:ss') }}\n{{ $('Detectar D7').item.json.texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}\n<b>Severidad:</b> CRÍTICA\n<b>Acción:</b> Verificar si es consulta legítima. Revisar logs de acceso de N8N y rotar la contraseña del usuario si no lo es.\n<i>Registro: alertas_auditoria {{ $('Registrar alerta D7').item.json.id }}</i>",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "enviar-telegram",
      "name": "Enviar alerta D7",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        100
      ],
      "webhookId": "nutri-D7-telegram",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_TELEGRAM__",
          "name": "Nutri Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alertas_auditoria\nSET estado = 'enviada', enviada_en = now(), intentos = intentos + 1\nWHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Registrar alerta D7').item.json.id ] }}"
        }
      },
      "id": "marcar-enviada",
      "name": "Marcar enviada D7",
      "type": "n8n-nodes-base.postgres",
