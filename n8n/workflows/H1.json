        [
          {
            "node": "¿Hay hallazgo?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar alerta H1": {
      "main": [
        [
          {
            "node": "Marcar enviada H1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay hallazgo?": {
      "main": [
        [
          {
            "node": "Enviar alerta H1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
