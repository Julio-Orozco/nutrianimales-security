{
  "id": "nutriH1alerta00",
  "name": "Nutri H1 — Puerto abierto o regla UFW modificada",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "cada-30-segundos",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Sondeo periódico de la regla H1.",
      "notesInFlow": true
    },
    {
      "parameters": {},
      "id": "prueba-manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "notes": "Ejecutar la regla a mano desde el editor.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id::text AS id, huella,\n       format(E'Fuente: %s\\nReglas agregadas: %s\\nReglas eliminadas: %s\\nEstado UFW: %s\\nHash anterior: %s... | Hash nuevo: %s...\\nDetectado por el agente: %s',\n              detalles->>'fuente',\n              coalesce((SELECT string_agg(x, ' | ') FROM jsonb_array_elements_text(detalles->'agregadas') x), 'ninguna'),\n              coalesce((SELECT string_agg(x, ' | ') FROM jsonb_array_elements_text(detalles->'eliminadas') x), 'ninguna'),\n              detalles->>'estado', left(detalles->>'hash_anterior', 12), left(detalles->>'hash_actual', 12),\n              to_char(fecha, 'YYYY-MM-DD HH24:MI:SS')) AS texto\nFROM alertas_auditoria\nWHERE alerta = 'H1' AND estado = 'pendiente'\nORDER BY fecha\nLIMIT 5;",
        "options": {}
      },
      "id": "detectar",
      "name": "Detectar H1",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Fuente: Agente del host (hash de UFW) -> alertas_auditoria pendientes",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.huella }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "-hay-hallazgo-",
      "name": "¿Hay hallazgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "=<b>ALERTA CRÍTICA - NutriAnimales S.A. | Lead University BCD 9220</b>\n<b>Alerta:</b> H1 — Puerto abierto o regla UFW modificada\n<b>Fecha:</b> {{ $now.setZone('America/Costa_Rica').toFormat('yyyy-MM-dd HH:mm:ss') }}\n{{ $('Detectar H1').item.json.texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}\n<b>Severidad:</b> CRÍTICA\n<b>Acción:</b> Confirmar si el cambio fue autorizado; si no, revertir con sudo ufw delete &lt;regla&gt;.\n<i>Registro: alertas_auditoria {{ $('Detectar H1').item.json.id }}</i>",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "enviar-telegram",
      "name": "Enviar alerta H1",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        100
      ],
      "webhookId": "nutri-H1-telegram",
      "credentials": {
        "telegramApi": {
          "id": "__CRED_TELEGRAM__",
          "name": "Nutri Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE alertas_auditoria\nSET estado = 'enviada', enviada_en = now(), intentos = intentos + 1\nWHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Detectar H1').item.json.id ] }}"
        }
      },
      "id": "marcar-enviada",
      "name": "Marcar enviada H1",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        960,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_MONITOR__",
          "name": "Nutri Postgres monitor_db"
        }
      },
      "notes": "Deja constancia de la entrega en alertas_auditoria.",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Cada 30 segundos": {
      "main": [
        [
          {
            "node": "Detectar H1",
            "type": "main",
            "index": 0
